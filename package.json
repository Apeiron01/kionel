{
  "name": "kionel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "node --experimental-strip-types --no-warnings apps/bench/bench.ts",
    "bench:optical": "node --experimental-strip-types --no-warnings packages/conformance/src/bench-optical.ts",
    "verify": "node --experimental-strip-types --no-warnings apps/verify/verify.ts",
    "prove": "node tools/prove.mjs",
    "audit:verify": "node --experimental-strip-types --no-warnings apps/audit/verify.ts",
    "trust:verify": "node --experimental-strip-types --no-warnings apps/enterprise/verify.ts",
    "api:spec": "node --experimental-strip-types --no-warnings apps/control-plane/spec.ts",
    "native:windows:build": "dotnet build native/windows/Kionel.WindowsKeyHost/Kionel.WindowsKeyHost.csproj -c Release",
    "native:windows:test": "dotnet run --project native/windows/Kionel.WindowsKeyHost.Tests/Kionel.WindowsKeyHost.Tests.csproj -c Release",
    "native:windows:diagnose": "node --experimental-strip-types --no-warnings apps/windows/qualify.ts",
    "native:windows:qualify": "node --experimental-strip-types --no-warnings apps/windows/qualify.ts --provision",
    "android:trust:sync": "node --experimental-strip-types --no-warnings apps/android/sync-trust.ts",
    "android:trust:verify": "node --experimental-strip-types --no-warnings apps/android/sync-trust.ts --verify-only",
    "qualify": "node --experimental-strip-types --no-warnings apps/qualification/qualify.ts",
    "matrix:merge": "node --experimental-strip-types --no-warnings apps/qualification/merge.ts",
    "sbom": "node --experimental-strip-types --no-warnings apps/release/sbom.ts",
    "release:manifest": "node --experimental-strip-types --no-warnings apps/release/manifest.ts",
    "release:check": "pnpm typecheck && pnpm test && pnpm build && pnpm audit",
    "fuzz": "node --experimental-strip-types --no-warnings apps/security/fuzz.ts",
    "dev": "pnpm --filter @kionel/web dev",
    "build": "pnpm --filter @kionel/web build",
    "test": "vitest run",
    "test:browser": "node tools/browser-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/commerce/tsconfig.json --noEmit",
    "site:dev": "wrangler dev --config apps/commerce/wrangler.jsonc",
    "site:types": "wrangler types --strict-vars false --include-runtime false --config apps/commerce/wrangler.jsonc apps/commerce/worker-configuration.d.ts",
    "site:check": "wrangler deploy --dry-run --config apps/commerce/wrangler.jsonc",
    "site:migrate:local": "wrangler d1 migrations apply kionel-commerce --local --config apps/commerce/wrangler.jsonc",
    "site:migrate": "wrangler d1 migrations apply kionel-commerce --remote --config apps/commerce/wrangler.jsonc",
    "web:fonts": "python tools/fetch-fonts.py",
    "web:policies": "python tools/build-policies.py",
    "web:segments": "node --experimental-strip-types --no-warnings tools/build-segments.mjs",
    "tsa:fixtures": "node packages/timestamp/test-fixtures/generate.mjs",
    "attest": "node --experimental-strip-types --no-warnings apps/attest/attest.ts",
    "method": "node --experimental-strip-types --no-warnings apps/attest/method.ts",
    "method:demo": "node --experimental-strip-types --no-warnings apps/attest/method-demo.ts",
    "handover:demo": "node --experimental-strip-types --no-warnings apps/attest/handover-demo.ts",
    "license": "node --experimental-strip-types --no-warnings apps/license/license.ts",
    "cli:build": "node tools/build-cli.mjs",
    "web:guides": "node --experimental-strip-types --no-warnings tools/build-guides.mjs",
    "web:funnel": "node tools/build-funnel.mjs",
    "web:import-check": "node tools/build-import-check.mjs",
    "launch:prepare": "pnpm web:policies && pnpm web:segments && pnpm web:guides && pnpm web:funnel && pnpm web:import-check && node tools/prepare-launch.mjs",
    "launch:check": "node tools/prepare-launch.mjs --check",
    "deploy": "pnpm launch:prepare && pnpm build && pnpm site:check && wrangler deploy --config apps/commerce/wrangler.jsonc",
    "indexnow": "node tools/indexnow.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^22.10.2",
    "esbuild": "0.25.12",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.130.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "undici": "7.29.1",
      "source-map-js": "1.2.2",
      "sharp": "0.35.5"
    }
  },
  "packageManager": "pnpm@10.0.0",
  "license": "AGPL-3.0-only"
}
