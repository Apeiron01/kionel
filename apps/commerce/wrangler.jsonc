{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kionel",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kionel-commerce",
      "database_id": "9f1d98ad-94bc-4321-85eb-0d068c0f1be3",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "SITE_URL": "https://kionel.com",
    "SUPPORT_EMAIL": "legal@luminadigitale.com"
  },
  "routes": [
    {
      "pattern": "kionel.com",
      "custom_domain": true
    }
  ]
}
